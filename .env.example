# EODHD API key (https://eodhd.com)
EODHD_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Daily EODHD credit cap. News fetches are blocked at 80% of this value;
# all paid calls hard-stop at 100%.
EODHD_DAILY_CREDIT_CAP=20000

# SQLite path (absolute recommended in production)
DB_PATH=catalyst.db

# Universe screener thresholds
UNIVERSE_MARKET_CAP_MIN=1000000000
UNIVERSE_PRICE_MIN=10
UNIVERSE_AVG_VOL_MIN=100000

# Default per-user gap threshold (percent)
DEFAULT_GAP_THRESHOLD=5.0

# Drop hits whose latest trade is older than this many hours. Default 12h is
# tuned so a /run_now during late post-market still surfaces that day's close
# but yesterday's regular session is filtered out. Set lower (e.g. 4) for
# stricter "current data only" semantics.
MAX_HIT_AGE_HOURS=24

# How long the WebSocket trade collector listens during pre-/post-market
# scans, in seconds. 0 disables the WS overlay (HTTP-only). The All-In-One
# plan supports /ws/us with up to 50 symbols per connection; this module
# chunks the universe and opens one connection per chunk in parallel.
WS_COLLECT_SECONDS=20

# Scheduled scan times (Europe/Nicosia by default).
# Pre-market: ~04:30 ET. Post-market: ~16:30 ET (earnings window).
# Per-user opt-in is controlled via /frequency — these only set when the crons fire.
SCAN_HOUR=11
SCAN_MINUTE=30
POST_SCAN_HOUR=23
POST_SCAN_MINUTE=30
SCAN_TIMEZONE=Europe/Nicosia

# Optional override universe (comma-separated, e.g. AAPL.US,TSLA.US) for dry-runs.
# When set, the screener is skipped entirely.
OVERRIDE_UNIVERSE=

LOG_LEVEL=INFO
